# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=delivery_tracking
DATABASE_USER=postgres
DATABASE_PASSWORD=

# ── Simulator (set in simulator/.env or as inline env vars) ──────────────────
# These are used by the simulator, not the backend itself.
# Listed here for reference so the whole configuration is in one place.
BACKEND_URL=http://localhost:3000
